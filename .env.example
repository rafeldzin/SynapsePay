# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Database Connection (SQLite default, can be swapped to Postgres)
DATABASE_URL=sqlite:///./db/synapsepay.db

# Gate 0 Spike & Sandbox Receiver Configuration
SPIKE_RECEIVER_EMAIL=your_sandbox_registered_contractor@business.example.com
SANDBOX_CONTRACTOR_EMAIL=your_sandbox_registered_contractor@business.example.com
SANDBOX_RECEIVER_UNCLAIMED=unregistered-test-account@example.com

# Demo Scenario Configuration (used by POST /demo/reset)
# DEMO_CONTRACTOR_EMAIL: registered sandbox personal account (reaches item status SUCCESS)
DEMO_CONTRACTOR_EMAIL=your_sandbox_registered_contractor@business.example.com
# DEMO_TYPO_EMAIL: unregistered email to simulate UNCLAIMED scenario (typo/wrong address)
DEMO_TYPO_EMAIL=unregistered-typo-address@example.com
# Milestone amounts for demo reset seeding
DEMO_AMOUNT_M1=300.00
DEMO_AMOUNT_M2=200.00

# Optional: Override database file path (overrides DATABASE_URL if set)
# DATABASE_PATH=./db/synapsepay.db
